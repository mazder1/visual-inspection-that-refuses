# Project brief, kept local
briefvisualinspection.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Notebooks
.ipynb_checkpoints/

# Throwaway diagnostics: cluster contact sheets and similar
scratch/

# Serving bundles: chain.json is tracked (the frozen decision chain), the
# model weights are rebuilt by `python -m vinspect.serve.export`.
bundles/*/model.pt

# Data, models, outputs. Root-anchored: an unanchored data/ also matched
# src/vinspect/data and silently kept the whole loader package out of the
# repo, which CI caught when a clean checkout could not import it.
/data/
/datasets/
checkpoints/
*.pt
*.pth
*.ckpt
# Training outputs: checkpoints are excluded by the *.pt rule above, but the
# result JSONs and run logs are the project's findings and belong in the repo.
outputs/
wandb/
mlruns/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
runs/*.err

# Local wheel-build artifacts
/build/
/scratch/

# Exported inference graphs, rebuilt by vinspect.serve.onnx_export
bundles/*/*.onnx
